{
  "name": "eminence-astro-suite-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "types": "pnpm --filter ./docs types",
    "dev": "pnpm --filter ./docs dev",
    "build": "pnpm --filter ./docs build",
    "preview": "pnpm --filter ./docs preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm astro check && pnpm test",
    "all": "pnpm format && pnpm astro check && pnpm test",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "pnpm": "11.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "astro": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "sharp": "catalog:",
    "sharp-ico": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  }
}
