{
  "extends": "astro/tsconfigs/strict",
  "include": ["package/**/*", "test/**/*", "vitest.config.ts"],
  "exclude": ["dist", "docs/dist"],
  "compilerOptions": {
    "paths": {
      "~/*": ["./docs/public/*"],
      "@/*": ["./docs/src/*"],
      "@package/*": ["./package/*"],
      "@test/*": ["./test/*"]
    }
  }
}
